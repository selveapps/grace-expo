# Copy to .env for local development (never commit .env)
# Local API (backend on :3000)
EXPO_PUBLIC_API_BASE=http://localhost:3000
EXPO_PUBLIC_BETA_REDEEM_CODE=grace-beta

# M11 IAP — EAS dev build only (GRACE-026). Leave false/unset for Expo Go.
# EXPO_PUBLIC_IAP_ENABLED=true
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=pk_...
# EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=pk_...

# Staging / beta testers — see .env.staging.example
# EXPO_PUBLIC_API_BASE=https://grace-api-production.up.railway.app
