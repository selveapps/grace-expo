diff --git a/server/auth/rsvp/html.mjs b/server/auth/rsvp/html.mjs
new file mode 100644
index 0000000..b43e126
--- /dev/null
+++ b/server/auth/rsvp/html.mjs
@@ -0,0 +1,99 @@
+/**
+ * Safe HTML for the public pages (design E §5, threat W3).
+ *
+ * Every value interpolated into `html` is escaped. The only way to insert
+ * markup is another `html` result (or `raw`, used only for constant strings in
+ * this folder), so a guest's name or a couple's FAQ text can never become a
+ * script, an attribute or a tag.
+ */
+
+const ESCAPES = {
+  '&': '&amp;',
+  '<': '&lt;',
+  '>': '&gt;',
+  '"': '&quot;',
+  "'": '&#39;',
+  '`': '&#96;',
+};
+
+export function escapeHtml(value) {
+  return String(value ?? '').replace(/[&<>"'`]/g, (char) => ESCAPES[char]);
+}
+
+class SafeHtml {
+  constructor(value) {
+    this.value = value;
+  }
+
+  toString() {
+    return this.value;
+  }
+}
+
+/** Mark a constant string as markup. Never pass user input here. */
+export const raw = (value) => new SafeHtml(String(value));
+
+function render(value) {
+  if (value instanceof SafeHtml) return value.value;
+  if (Array.isArray(value)) return value.map(render).join('');
+  if (value === null || value === undefined || value === false) return '';
+  return escapeHtml(value);
+}
+
+/** Tagged template: `html\`<p>${name}</p>\`` escapes `name`. */
+export function html(strings, ...values) {
+  let out = strings[0];
+  for (let i = 0; i < values.length; i += 1) out += render(values[i]) + strings[i + 1];
+  return new SafeHtml(out);
+}
+
+/**
+ * Headers for every public page: no framing, no sniffing, no referrer (tokens
+ * are in the URL), no indexing, no caching of personal pages, and a CSP that
+ * allows no script at all.
+ */
+export const PAGE_HEADERS = {
+  'Content-Type': 'text/html; charset=utf-8',
+  'Content-Security-Policy':
+    "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+  'X-Frame-Options': 'DENY',
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'X-Robots-Tag': 'noindex, nofollow',
+  'Cache-Control': 'no-store',
+};
+
+const STYLES = raw(`
+  :root { color-scheme: light dark; --ink: #2b2220; --muted: #6f625e; --line: #e8ddd8; --bg: #fffbf7; --card: #ffffff; --brand: #b4485f; }
+  @media (prefers-color-scheme: dark) { :root { --ink: #f3ebe7; --muted: #b9aca7; --line: #3a302d; --bg: #191413; --card: #241d1b; --brand: #f49ab3; } }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
+  main { max-width: 560px; margin: 0 auto; padding: 32px 16px 64px; }
+  h1 { font-family: Georgia, "Times New Roman", serif; font-weight: 500; font-size: 30px; line-height: 1.2; margin: 0 0 4px; }
+  .muted { color: var(--muted); }
+  .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px; margin: 20px 0; }
+  fieldset { border: 0; margin: 0 0 20px; padding: 0; }
+  legend { font-weight: 600; margin-bottom: 8px; }
+  label { display: block; margin: 8px 0 4px; }
+  .choice { display: inline-flex; align-items: center; gap: 6px; margin-right: 18px; }
+  input[type=text], select, textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); font: inherit; }
+  textarea { min-height: 96px; }
+  button { background: var(--brand); color: #fff; border: 0; border-radius: 999px; padding: 14px 24px; font: inherit; font-weight: 600; width: 100%; cursor: pointer; }
+  .error { color: #c0392b; }
+  .ok { color: #2e7d4f; }
+`);
+
+/** The page shell. `title` and `body` follow the same escaping rules. */
+export function page({ title, body, lang = 'en' }) {
+  return html`<!doctype html>
+<html lang="${lang}">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="robots" content="noindex, nofollow">
+<title>${title}</title>
+<style>${STYLES}</style>
+</head>
+<body><main>${body}</main></body>
+</html>`;
+}
diff --git a/server/auth/rsvp/pages.mjs b/server/auth/rsvp/pages.mjs
new file mode 100644
index 0000000..e49b8ae
--- /dev/null
+++ b/server/auth/rsvp/pages.mjs
@@ -0,0 +1,133 @@
+import { html, page } from './html.mjs';
+import { MEAL_CHOICES } from './rsvp.mjs';
+
+/**
+ * The guest-facing RSVP pages. Plain HTML forms, no script: they load fast on
+ * a weak connection and work in any browser (design E §2). Guests see first
+ * names only, and only their own invitation's guests (W2).
+ */
+
+const formatDate = (iso) => {
+  if (!iso || Number.isNaN(Date.parse(iso))) return null;
+  return new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-US', {
+    weekday: 'long',
+    month: 'long',
+    day: 'numeric',
+    year: 'numeric',
+    timeZone: 'UTC',
+  });
+};
+
+export function coupleTitle(wedding) {
+  const names = [wedding?.ownerName, wedding?.partnerName].map((name) => name?.trim()).filter(Boolean);
+  return names.length ? names.join(' & ') : 'Our wedding';
+}
+
+function weddingHeader(wedding, settings) {
+  const date = wedding?.dateType === 'exact' ? formatDate(wedding?.date) : null;
+  const place = [wedding?.venueName, wedding?.city].map((part) => part?.trim()).filter(Boolean).join(', ');
+  const deadline = formatDate(settings?.deadline);
+  return html`
+    <h1>${coupleTitle(wedding)}</h1>
+    ${date ? html`<p class="muted">${date}${place ? html` · ${place}` : ''}</p>` : place ? html`<p class="muted">${place}</p>` : ''}
+    ${deadline ? html`<p>Please reply by <strong>${deadline}</strong>.</p>` : ''}`;
+}
+
+function guestFields(guest, questions, previous, error) {
+  const was = previous?.guests?.find((answer) => answer.guestId === guest.id) ?? null;
+  const yes = was?.attending === true;
+  const no = was?.attending === false;
+  const mealOptions = MEAL_CHOICES.map(
+    (choice) => html`<option value="${choice.value}"${was?.meal === choice.value ? html` selected` : ''}>${choice.label}</option>`
+  );
+  return html`
+    <fieldset>
+      <legend>${guest.firstName}</legend>
+      ${error ? html`<p class="error" role="alert">${error}</p>` : ''}
+      <span class="choice"><input type="radio" id="yes_${guest.id}" name="attending_${guest.id}" value="yes"${yes ? html` checked` : ''}><label for="yes_${guest.id}">Joyfully accepts</label></span>
+      <span class="choice"><input type="radio" id="no_${guest.id}" name="attending_${guest.id}" value="no"${no ? html` checked` : ''}><label for="no_${guest.id}">Regretfully declines</label></span>
+      ${questions.meals
+        ? html`<label for="meal_${guest.id}">Meal</label>
+            <select id="meal_${guest.id}" name="meal_${guest.id}"><option value="">No preference</option>${mealOptions}</select>`
+        : ''}
+      ${questions.dietary
+        ? html`<label for="dietary_${guest.id}">Allergies or dietary needs</label>
+            <input type="text" id="dietary_${guest.id}" name="dietary_${guest.id}" maxlength="300" value="${was?.dietary ?? ''}">`
+        : ''}
+      ${questions.plusOnes && guest.plusOneAllowed
+        ? html`<label for="plusone_${guest.id}">Bringing a guest? Their name</label>
+            <input type="text" id="plusone_${guest.id}" name="plusone_${guest.id}" maxlength="80" value="${was?.plusOneName ?? ''}">`
+        : ''}
+    </fieldset>`;
+}
+
+/** The RSVP form. `hidden` carries the short code when the guest came in by code. */
+export function formPage({ context, action, hidden = {}, errors = {}, closed = false }) {
+  const { wedding, settings, guests, previous } = context;
+  const { questions } = settings;
+  const title = `RSVP - ${coupleTitle(wedding)}`;
+
+  if (closed) {
+    return page({
+      title,
+      body: html`${weddingHeader(wedding, settings)}
+        <div class="card"><p>Replies have closed. If something has changed, please contact the couple directly.</p></div>`,
+    });
+  }
+
+  return page({
+    title,
+    body: html`${weddingHeader(wedding, settings)}
+      ${previous ? html`<p class="ok">We have your reply. You can change it below until the deadline.</p>` : ''}
+      ${errors.form ? html`<p class="error" role="alert">${errors.form}</p>` : ''}
+      <form method="post" action="${action}" class="card">
+        ${Object.entries(hidden).map(([name, value]) => html`<input type="hidden" name="${name}" value="${value}">`)}
+        <input type="hidden" name="submit" value="1">
+        ${guests.map((guest) => guestFields(guest, questions, previous, errors[guest.id]))}
+        ${questions.message
+          ? html`<label for="message">A note for the couple (optional)</label>
+              <textarea id="message" name="message" maxlength="1000">${previous?.message ?? ''}</textarea>
+              ${errors.message ? html`<p class="error" role="alert">${errors.message}</p>` : ''}`
+          : ''}
+        <p><button type="submit">Send our reply</button></p>
+      </form>`,
+  });
+}
+
+export function confirmationPage({ context, response }) {
+  const { wedding, settings, guests } = context;
+  const name = (id) => guests.find((guest) => guest.id === id)?.firstName ?? 'Guest';
+  const coming = response.guests.filter((answer) => answer.attending);
+  return page({
+    title: `Thank you - ${coupleTitle(wedding)}`,
+    body: html`${weddingHeader(wedding, settings)}
+      <div class="card">
+        <p class="ok"><strong>Thank you - your reply is in.</strong></p>
+        <ul>
+          ${response.guests.map(
+            (answer) =>
+              html`<li>${name(answer.guestId)}: ${answer.attending ? 'attending' : 'not attending'}${answer.plusOneName ? html`, with ${answer.plusOneName}` : ''}</li>`
+          )}
+        </ul>
+        <p class="muted">${coming.length ? 'We cannot wait to celebrate with you.' : 'You will be missed.'} You can come back to this page to change your reply until the deadline.</p>
+      </div>`,
+  });
+}
+
+/** Typing the code from a paper invitation. */
+export function codePage({ wedding, action, error = null }) {
+  return page({
+    title: `RSVP - ${coupleTitle(wedding)}`,
+    body: html`<h1>${coupleTitle(wedding)}</h1>
+      <form method="post" action="${action}" class="card">
+        <label for="code">Enter the code from your invitation</label>
+        <input type="text" id="code" name="code" autocomplete="off" autocapitalize="characters" maxlength="12" placeholder="ABCD-EFGH">
+        ${error ? html`<p class="error" role="alert">${error}</p>` : ''}
+        <p><button type="submit">Find our invitation</button></p>
+      </form>`,
+  });
+}
+
+export function messagePage({ title, message }) {
+  return page({ title, body: html`<h1>${title}</h1><div class="card"><p>${message}</p></div>` });
+}
diff --git a/server/auth/rsvp/routes.mjs b/server/auth/rsvp/routes.mjs
new file mode 100644
index 0000000..0cefc8e
--- /dev/null
+++ b/server/auth/rsvp/routes.mjs
@@ -0,0 +1,147 @@
+import { RSVP_LIMITS, repliesOpen, validateSettings } from './rsvp.mjs';
+import { codePage, confirmationPage, formPage, messagePage } from './pages.mjs';
+
+/**
+ * RSVP routes (design E §3, slice E1a).
+ *
+ * Couple side, JSON, membership-checked like every workspace route:
+ *   GET  /v1/workspaces/:id/rsvp/settings                 -> 200 { settings }
+ *   PUT  /v1/workspaces/:id/rsvp/settings   { slug, deadline, questions } -> 200 { settings }
+ *   GET  /v1/workspaces/:id/rsvp/invites                  -> 200 { invites }
+ *   POST /v1/workspaces/:id/rsvp/invites    { targets }   -> 201 { invites: [{ url, code, ... }] }
+ *   POST /v1/workspaces/:id/rsvp/invites/:inviteId/revoke -> 204
+ *
+ * Guest side, HTML, no account:
+ *   GET|POST /r/:token        the form for one invitation
+ *   GET|POST /w/:slug/rsvp    type the code from a paper invitation
+ */
+
+const TARGET_ID = /^[A-Za-z0-9_-]{1,128}$/;
+const HOUR = 60 * 60 * 1000;
+
+/** Counts per key over a sliding window. */
+function createWindowLimiter(limit, windowMs) {
+  const hits = new Map();
+  return (key) => {
+    const now = Date.now();
+    const recent = (hits.get(key) ?? []).filter((t) => now - t < windowMs);
+    recent.push(now);
+    hits.set(key, recent);
+    return recent.length > limit;
+  };
+}
+
+export const RSVP_RATE_LIMITS = {
+  codeAttemptsPerIpPerHour: 10,
+  codeAttemptsPerWeddingPerHour: 50,
+  pageRequestsPerIpPerMinute: 60,
+};
+
+export function registerRsvpRoutes(router, { db, send, sendHtml, readJson, readForm, clientIp, publicBaseUrl }) {
+  const codePerIp = createWindowLimiter(RSVP_RATE_LIMITS.codeAttemptsPerIpPerHour, HOUR);
+  const codePerWedding = createWindowLimiter(RSVP_RATE_LIMITS.codeAttemptsPerWeddingPerHour, HOUR);
+  const pagePerIp = createWindowLimiter(RSVP_RATE_LIMITS.pageRequestsPerIpPerMinute, 60 * 1000);
+
+  // --- Couple side ---------------------------------------------------------------
+
+  router.add('GET', '/v1/workspaces/:id/rsvp/settings', (req, res, { workspace }) =>
+    send(res, 200, { settings: db.rsvp.getSettings(workspace.id) })
+  );
+
+  router.add('PUT', '/v1/workspaces/:id/rsvp/settings', async (req, res, { workspace }) => {
+    const body = await readJson(req);
+    const fields = validateSettings(body);
+    if (fields) return send(res, 400, { error: 'invalid', fields });
+    const result = db.rsvp.saveSettings(workspace.id, {
+      slug: body.slug,
+      deadline: body.deadline,
+      questions: body.questions,
+    });
+    if (result.error) return send(res, 409, { error: result.error });
+    return send(res, 200, { settings: result.settings });
+  });
+
+  router.add('GET', '/v1/workspaces/:id/rsvp/invites', (req, res, { workspace }) =>
+    send(res, 200, { invites: db.rsvp.listInvites(workspace.id) })
+  );
+
+  router.add('POST', '/v1/workspaces/:id/rsvp/invites', async (req, res, { workspace }) => {
+    const { targets } = await readJson(req);
+    const valid =
+      Array.isArray(targets) &&
+      targets.length > 0 &&
+      targets.length <= RSVP_LIMITS.invitesPerRequest &&
+      targets.every(
+        (target) =>
+          (target?.type === 'household' || target?.type === 'guest') &&
+          typeof target.id === 'string' &&
+          TARGET_ID.test(target.id)
+      );
+    if (!valid) return send(res, 400, { error: 'invalid' });
+    const invites = db.rsvp.createInvites(workspace.id, targets).map(({ token, ...invite }) => ({
+      ...invite,
+      url: `${publicBaseUrl}/r/${token}`,
+    }));
+    return send(res, 201, { invites });
+  });
+
+  router.add('POST', '/v1/workspaces/:id/rsvp/invites/:inviteId/revoke', (req, res, { workspace, params }) =>
+    db.rsvp.revoke(workspace.id, params.inviteId) ? send(res, 204) : send(res, 404, { error: 'not_found' })
+  );
+
+  // --- Guest side ----------------------------------------------------------------
+
+  const browser = { access: 'public', browser: true };
+  const inactive = () =>
+    messagePage({
+      title: 'This link is no longer active',
+      message: 'Please check the invitation, or contact the couple for a new link.',
+    });
+  const tooMany = () =>
+    messagePage({ title: 'Please wait a moment', message: 'Too many tries from this connection. Try again later.' });
+
+  /** `form` is the already-read POST body, or null for a GET. A body can only be read once. */
+  function invitationForm(res, invite, { action, hidden, form }) {
+    const context = db.rsvp.formContext(invite);
+    const closed = !repliesOpen(context.settings);
+    if (!form || closed) {
+      if (!form) db.rsvp.markOpened(invite);
+      return sendHtml(res, 200, formPage({ context, action, hidden, closed }));
+    }
+    if (!form.submit) return sendHtml(res, 200, formPage({ context, action, hidden }));
+    const result = db.rsvp.submit(invite, form);
+    if (result.errors) return sendHtml(res, 400, formPage({ context, action, hidden, errors: result.errors }));
+    return sendHtml(res, 200, confirmationPage({ context: db.rsvp.formContext(invite), response: result.response }));
+  }
+
+  const byToken = async (req, res, { params }) => {
+    if (pagePerIp(clientIp(req))) return sendHtml(res, 429, tooMany());
+    const invite = db.rsvp.findByToken(params.token);
+    if (!invite) return sendHtml(res, 404, inactive());
+    const form = req.method === 'POST' ? await readForm(req) : null;
+    return invitationForm(res, invite, { action: `/r/${encodeURIComponent(params.token)}`, hidden: {}, form });
+  };
+  router.add('GET', '/r/:token', byToken, browser);
+  router.add('POST', '/r/:token', byToken, browser);
+
+  const byCode = async (req, res, { params }) => {
+    const workspaceId = db.rsvp.workspaceForSlug(params.slug);
+    if (!workspaceId) {
+      return sendHtml(res, 404, messagePage({ title: 'Page not found', message: 'Check the address on your invitation.' }));
+    }
+    const wedding = db.sync.liveRecords(workspaceId, 'wedding')[0]?.data ?? null;
+    const action = `/w/${encodeURIComponent(params.slug)}/rsvp`;
+    if (req.method === 'GET') return sendHtml(res, 200, codePage({ wedding, action }));
+
+    const form = await readForm(req);
+    // Every code lookup counts, so guessing is slow per address and per wedding (W1).
+    if (codePerIp(clientIp(req)) || codePerWedding(workspaceId)) return sendHtml(res, 429, tooMany());
+    const invite = db.rsvp.findByCode(workspaceId, form.code);
+    if (!invite) {
+      return sendHtml(res, 400, codePage({ wedding, action, error: 'That code does not match an invitation here.' }));
+    }
+    return invitationForm(res, invite, { action, hidden: { code: form.code }, form });
+  };
+  router.add('GET', '/w/:slug/rsvp', byCode, browser);
+  router.add('POST', '/w/:slug/rsvp', byCode, browser);
+}
diff --git a/server/auth/rsvp/rsvp.mjs b/server/auth/rsvp/rsvp.mjs
